# ---------- Gateway (apps/gateway) ----------
PORT=4021

# stellar:testnet while building, stellar:pubnet for mainnet
NETWORK=stellar:testnet

# Facilitator that verifies and settles payments on Stellar.
# OpenZeppelin "Built on Stellar" facilitator (testnet). Get a free testnet
# API key at https://channels.openzeppelin.com/testnet/gen
FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
FACILITATOR_API_KEY=

# Default payout address (G...) used by listings that don't set their own.
# The account needs a USDC trustline before it can receive payments.
PAY_TO=

# Path to the listings file, relative to apps/gateway
LISTINGS_FILE=listings.json

# ---------- Demo upstream API (apps/demo-api) ----------
DEMO_API_PORT=4100

# ---------- Agent (apps/agent) ----------
# Testnet secret key (S...) of the paying wallet. Testnet only.
STELLAR_PRIVATE_KEY=
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
GATEWAY_URL=http://localhost:4021
